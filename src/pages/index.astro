---
import Base from '../layouts/Base.astro';
const base=import.meta.env.BASE_URL;
---
<Base><section class="hero"><div><span class="eyebrow">Baked with love · Est. 2026</span><h1>Making life's little moments <em>sweeter.</em></h1><p>Discover Baked by Lottie and get in touch to chat about something sweet for your next celebration.</p><div class="buttons"><a class="button" href={base+'enquire/'}>Enquire about a cake</a><a class="button secondary" href={base+'gallery/'}>Explore the gallery</a></div></div><div class="brand-art"><span class="eyebrow">♡</span><strong>Baked<br/>by Lottie</strong><span class="eyebrow">Est. 2026</span></div></section><section class="section center"><span class="eyebrow">Something sweet</span><h2>For your special moments</h2><div class="grid"><article class="tile"><span class="symbol">♡</span><h3>Celebrate</h3><p>Make your next special occasion a little sweeter.</p></article><article class="tile"><span class="symbol">✿</span><h3>Get inspired</h3><p>Explore Lottie's latest creations on Instagram.</p><a href={base+'gallery/'}>View gallery</a></article><article class="tile"><span class="symbol">✧</span><h3>Make it personal</h3><p>Share your ideas and start a conversation.</p><a href={base+'enquire/'}>Get in touch</a></article></div></section><section class="band"><span class="eyebrow">Let's talk cake</span><h2>Have something in mind?</h2><p>Send Lottie a message to discuss your occasion.</p><a class="button" href={base+'enquire/'}>Start your enquiry</a></section></Base>