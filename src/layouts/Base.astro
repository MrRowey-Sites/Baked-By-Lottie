---
import '../styles/global.css';
const {title='Baked by Lottie',description='Beautiful bakes for your special moments.'}=Astro.props;
const base=import.meta.env.BASE_URL;
const links=[['Home',''],['Gallery','gallery/'],['Menu','menu/'],['About','about/'],['FAQ','faq/']];
---
<!doctype html><html lang="en-GB"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="icon" href={base+'favicon.svg'}/></head><body><a class="skip" href="#main">Skip to content</a><div class="ribbon">A little slice of happiness ♡</div><header><a class="brand" href={base}>Baked by Lottie<span>EST. 2026</span></a><nav aria-label="Main navigation">{links.map(([label,path])=><a href={base+path} aria-current={Astro.url.pathname===base+path?'page':undefined}>{label}</a>)}<a class="button" href={base+'enquire/'}>Enquire</a></nav></header><main id="main"><slot/></main><footer><a class="brand" href={base}>Baked by Lottie</a><p>Making life's little moments sweeter.</p><a href="https://www.instagram.com/bakedbylottiex/">Instagram · @bakedbylottiex</a><p><a href={base+'privacy/'}>Privacy</a> · © {new Date().getFullYear()} Baked by Lottie</p></footer></body></html>